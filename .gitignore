# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore asset meta data
!/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE folders
.vs/
.vscode/
.idea/
.gradle/

# Generated solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Keep the hand-written project used to run Core tests without Unity
!/Tools/**/*.csproj
/Tools/**/bin/
/Tools/**/obj/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and builds
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS files
.DS_Store
Thumbs.db
